{
  "boot-source": {
    "kernel_image_path": "/var/lib/interpose-sandbox/kernels/interpose-kernel-ubuntu-24.04-bpf-lsm-v0.1.0/kernel",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda lsm=lockdown,capability,landlock,yama,apparmor,bpf"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/var/lib/interpose-sandbox/sandboxes/<name>/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 2048,
    "smt": false
  },
  "vsock": {
    "guest_cid": 3,
    "uds_path": "/var/lib/interpose-sandbox/sandboxes/<name>/vsock.sock"
  }
}
